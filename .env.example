# ---- model provider (required for agents) ----
# bedrock | anthropic | openai | gemini
MODEL_PROVIDER=bedrock
# empty = tiers: bedrock Nova Lite / Nova 2 Lite / Nova Pro (fast/standard/strong). Set to pin every tier to one model
MODEL_ID=
# MODEL_ID_FAST=us.amazon.nova-lite-v1:0     MODEL_ID_STANDARD=us.amazon.nova-2-lite-v1:0     MODEL_ID_STRONG=us.amazon.nova-pro-v1:0 (or us.amazon.nova-premier-v1:0)
# MODEL_TIER_WATCH=fast  MODEL_TIER_TASKING=standard  MODEL_TIER_INVESTIGATOR=strong  MODEL_TIER_REPORT=strong
# ignored by models that reject sampling params (Claude 5 family, OpenAI reasoning models)
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=4096
# provider credentials: only the one for MODEL_PROVIDER is needed
AWS_REGION=us-east-1
# bedrock: docker compose mounts ~/.aws read-only; or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_PROFILE=default
# First watch-floor account on AWS (Cognito emails a temporary password) and its MFA policy:
# optional (default) or required. Read by scripts/deploy.sh, never by the local stack.
OFFICER_EMAIL=
OFFICER_MFA=optional
# anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# openai
OPENAI_API_KEY=
# openai: optional, any OpenAI-compatible endpoint
OPENAI_BASE_URL=
# gemini: https://aistudio.google.com/apikey (GEMINI_API_KEY also works)
GOOGLE_API_KEY=
# bedrock only
# legacy alias for MODEL_ID when MODEL_PROVIDER=bedrock (leave empty to use the Nova tiers)
BEDROCK_MODEL_ID=
# optional Bedrock Guardrail
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---- data ----
# POSTGIS_IMAGE=imresamu/postgis:17-3.5  # Apple Silicon: the official postgis/postgis image has no arm64 build
# replay | live
AIS_MODE=replay
# free key from https://aisstream.io (live mode only)
AISSTREAM_API_KEY=
# Watched areas besides the scenario's box (data/areas.yaml): all, scenario, or a comma list; live mode subscribes to all of them
WATCH_AREAS=all
# scenario minutes per real second
REPLAY_SPEED=60
# restart the replay after it completes (20 s pause) so the demo never goes quiet
REPLAY_LOOP=true
SCENARIO_FILE=/app/data/scenarios/east_med_baseline.yaml
SCENARIO_END=2026-09-01T08:00:00Z
# true = Overpass + Nominatim lookups (rate limited)
GEO_USE_OSM=false
# true = never call Copernicus Data Space
IMAGERY_OFFLINE=false
# optional, https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# ---- observability ----
OTEL_CONFIG=./observability/otel-collector.yaml
GRAFANA_ADMIN_PASSWORD=admin

# Candidates the Watch agent reviews per sweep, most suspicious first; the rest wait for the next sweep.
# Live AIS is patchy and a two-hour window can hold a hundred short gaps.
SWEEP_MAX_CANDIDATES=25

# On AWS the agents reach every tool through one AgentCore Gateway (set by the deploy).
# Leave empty locally: agents talk to the MCP containers directly.
TOOL_GATEWAY_URL=
